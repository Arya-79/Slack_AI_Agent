# ---------------------------------------------------------------------------
# Slack AI Agent — environment configuration
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# ---------------------------------------------------------------------------

# ── Slack (all required) ───────────────────────────────────────────────────
# Bot User OAuth Token (xoxb-…). Scopes: users:read, users:read.email,
# chat:write, channels:read.
SLACK_BOT_TOKEN=
# App-level token (xapp-…) with connections:write — needed for Socket Mode.
SLACK_APP_TOKEN=
# Signing secret from the app's Basic Information page.
SLACK_SIGNING_SECRET=
# Channel the analysis report card is posted to (e.g. C0123456789).
SLACK_PRIVATE_CHANNEL_ID=

# ── LLM provider ───────────────────────────────────────────────────────────
# Which model runs the analysis. All three use the OpenAI-compatible API.
#   openai — OpenAI            (paid; set OPENAI_API_KEY)
#   groq   — Groq              (FREE, no credit card; set GROQ_API_KEY) ← easiest
#   ollama — local Ollama      (free/offline; no key, needs Ollama running)
LLM_PROVIDER=groq

# Set the key for whichever provider you chose above:
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional overrides (each provider has a sensible default model):
#   openai → gpt-4o-mini   groq → llama-3.3-70b-versatile   ollama → llama3.1
LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_MAX_RETRIES=3
# Only for LLM_PROVIDER=ollama:
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── Database (required) ────────────────────────────────────────────────────
# PostgreSQL connection string, e.g. from Render.
DATABASE_URL=
# Set to "false" only for a locally-trusted Postgres without TLS.
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# ── Your company (used in the fit-analysis prompt) ─────────────────────────
COMPANY_NAME=Your Company
COMPANY_PRODUCT=Your Product

# ── Research tuning (optional) ─────────────────────────────────────────────
RESEARCH_ENABLED=true
DEDUPE_WINDOW_HOURS=24
RESEARCH_HTTP_TIMEOUT_MS=5000
RESEARCH_MAX_RESPONSE_BYTES=524288

# ── HTTP server / ops (optional) ───────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# When set, the read-only admin API requires this value in an X-API-Key header.
ADMIN_API_KEY=
